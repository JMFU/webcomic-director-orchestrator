# LinkedIn OAuth Configuration
# Para publicar artículos automáticamente, completa estos valores cuando los agentes estén pulidos

# =============================================================================
# CONFIGURACIÓN OAUTH 2.0 DE LINKEDIN
# =============================================================================
# Pasos para obtener las credenciales:
# 1. Crea una app en https://www.linkedin.com/developers/apps
# 2. Configura OAuth 2.0 con permisos: w_member_social, r_liteprofile
# 3. Genera el Access Token mediante el flujo de autorización
# 4. Copia tu User URN de tu perfil LinkedIn (urn:li:person:XXXXXXX)
# =============================================================================

# Access Token OAuth 2.0 (renovable)
LINKEDIN_ACCESS_TOKEN=

# URN del autor (perfil personal)
# Formato: urn:li:person:{ID}
# Para obtenerlo: inspect tu perfil en /in/{username} o usa la API
LINKEDIN_AUTHOR_URN=

# Tipo de publicación (ARTICLE o POST)
LINKEDIN_PUBLICATION_TYPE=ARTICLE

# Visibilidad: PUBLIC o CONNECTIONS
LINKEDIN_VISIBILITY=PUBLIC

# =============================================================================
# FLUJO DE AUTORIZACIÓN OAUTH
# =============================================================================
# URL de autorización:
# https://www.linkedin.com/oauth/v2/authorization?response_type=code&client_id={CLIENT_ID}&redirect_uri={REDIRECT_URI}&scope=w_member_social%20r_liteprofile

# Intercambio de código por token:
# POST https://www.linkedin.com/oauth/v2/accessToken
# params: grant_type=authorization_code, code={CODE}, redirect_uri={REDIRECT_URI}
# =============================================================================

# Client ID de tu LinkedIn App
LINKEDIN_CLIENT_ID=

# Client Secret de tu LinkedIn App
LINKEDIN_CLIENT_SECRET=

# URI de redirección registrada en tu app
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback

# =============================================================================
# NOTAS DE IMPLEMENTACIÓN
# =============================================================================
# - El Access Token expira. Implementar refresh token flow para renovaciones automáticas
# - Rate limit: 25 posts/día para Posts, 5 artículos/día para Articles via API
# - Alternativa: usar LinkedIn Personal Publish API (más permisos, proceso de revisión)
# =============================================================================